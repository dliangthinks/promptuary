{
  "server": {
    "name": "Promptuary",
    "version": "2.1.0",
    "port": 9090
  },
  "prompts": {
    "file": "promptsConfig.json",
    "registrationMode": "name"
  },
  "transports": {
    "default": "stdio",
    "sse": { "enabled": true },
    "stdio": { "enabled": true }
  },
  "logging": {
    "directory": "./logs",
    "level": "info"
  },
  "viewer": {
    "autoStart": true
  }
}
